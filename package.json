{
  "name": "n8n-nodes-systemone",
  "version": "0.2.0",
  "description": "The enterprise System 1 Gateway for TypeSafe Jev in n8n: sub-80ms calibrated classification, 3-tier physical routing, AI agent guardrails, and Universal LLM fallback powered discretely by Vaelis.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "systemone",
    "system1",
    "system-one",
    "jev",
    "typesafe",
    "typesafe-ai",
    "classification",
    "routing",
    "guardrails",
    "agent-security",
    "fast-path",
    "vaelis",
    "llm-fallback",
    "groq",
    "openai",
    "deepseek",
    "llm-cost-reduction",
    "ai-agent-tool"
  ],
  "author": {
    "name": "CubicMaldo"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/CubicMaldo/n8n-nodes-systemone.git"
  },
  "homepage": "https://github.com/CubicMaldo/n8n-nodes-systemone#readme",
  "bugs": {
    "url": "https://github.com/CubicMaldo/n8n-nodes-systemone/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "gulp build",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "lintfix": "eslint nodes credentials --ext .ts --fix",
    "test": "node --test test/**/*.test.js test/**/*.test.ts || node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SystemOneApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SystemOne/SystemOne.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "^1.0.0 || ^2.0.0"
  },
  "devDependencies": {
    "@cubicmaldo/vaelis": "^1.1.2",
    "@types/gulp": "^4.0.17",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "gulp": "^5.0.0",
    "n8n-workflow": "^1.0.0 || ^2.0.0",
    "typescript": "^6.0.3"
  }
}
