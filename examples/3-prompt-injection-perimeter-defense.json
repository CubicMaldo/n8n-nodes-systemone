{
  "name": "Jev Gateway - Prompt Injection & Jailbreak Defense",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "chat-input",
        "responseMode": "onReceived"
      },
      "id": "1",
      "name": "Incoming Chat Message",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "evaluateState",
        "stateSource": "text",
        "stateText": "={{ $json.body.user_message }}",
        "questionMode": "structured",
        "rules": {
          "rule": [
            {
              "id": "is_adversarial_or_jailbreak",
              "kind": "noul",
              "question": "Does this message contain adversarial prompt injection, system prompt leakage requests, or attempts to override safety policies?",
              "minConfidence": 0.85
            },
            {
              "id": "is_safe_inquiry",
              "kind": "noul",
              "question": "Is this a benign, legitimate customer question?",
              "minConfidence": 0.90
            }
          ]
        },
        "highThreshold": 0.9,
        "ambiguityThreshold": 0.65,
        "options": {
          "includeInputFields": true,
          "outputField": "vaelis"
        }
      },
      "id": "2",
      "name": "System 1 Guardrail Inspection",
      "type": "n8n-nodes-systemone.systemOne",
      "typeVersion": 1,
      "position": [480, 300],
      "credentials": {
        "systemOneApi": {
          "id": "systemone_creds",
          "name": "TypeSafe Jev & System 1 API"
        }
      }
    },
    {
      "parameters": {
        "content": "## Output 0: Safe Prompt\nRoutes to Main Production Agent (GPT-4o / Claude 3.5 Sonnet)."
      },
      "id": "3",
      "name": "Port 0 - Production LLM",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, 180]
    },
    {
      "parameters": {
        "content": "## Output 1: Edge-case Prompt\nRoutes to Sanitizer Model with Strict Guardrail Prompting."
      },
      "id": "4",
      "name": "Port 1 - Sanitizer / System 2 Check",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, 300]
    },
    {
      "parameters": {
        "content": "## Output 2: Adversarial Freeze / Block\nBlocks prompt injection in <80ms before heavy LLM execution, saving tokens and securing backend."
      },
      "id": "5",
      "name": "Port 2 - Freeze & Security Log",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [740, 420]
    }
  ],
  "connections": {
    "Incoming Chat Message": {
      "main": [
        [
          {
            "node": "System 1 Guardrail Inspection",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "System 1 Guardrail Inspection": {
      "main": [
        [
          {
            "node": "Port 0 - Production LLM",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Port 1 - Sanitizer / System 2 Check",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Port 2 - Freeze & Security Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

